APP_ENV=prod
APP_SECRET=b8af5469dba274d823b79bd8348e10fe
APP_LOCALE=en
DATABASE_URL=sqlite:///%kernel.project_dir%/var/data/unifi.db

# UniFi network scan (optional). Leave UNIFI_API_KEY empty to disable the scan.
# Never commit a real key: put it in .env.local or in the container environment.
UNIFI_BASE_URL=
UNIFI_API_KEY=
UNIFI_SITE=default
# Set to false if the Dream Machine uses its default self-signed certificate.
UNIFI_VERIFY_TLS=true
# Cron expression for a scheduled scan inside the container, e.g. "0 * * * *" (hourly). Empty = off.
UNIFI_SCAN_SCHEDULE=
